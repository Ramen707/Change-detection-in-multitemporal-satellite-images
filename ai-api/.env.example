# Create a Gemini API key in Google AI Studio for local development.
# Never commit a real key or paste one into frontend JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
PORT=10000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AI_RATE_LIMIT_PER_MINUTE=3
AI_DAILY_REQUEST_LIMIT=60
